# 应用层 compose 的覆盖变量（复制为 deploy/.env 后修改）
# 只放生产密钥类配置；中间件连接信息已在 docker-compose.app.yml 内固定为容器名

# FastAPI 签名/加密用密钥（生产环境务必替换：python -c "import secrets; print(secrets.token_urlsafe(48))"）
JQEVAL_SECRET_KEY=jqeval-secret-key-change-me

# JWT 签名密钥（同上务必替换）
JQEVAL_JWT_SECRET_KEY=jqeval-jwt-secret-change-me
